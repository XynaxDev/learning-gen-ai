# API Keys
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Ngrok Configuration (Optional - for sharing your app)
# NGROK_AUTHTOKEN=your_ngrok_token_here

# Model Configuration
DEFAULT_MODEL=llama3.2:3b
USE_LOCAL_OLLAMA=true

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual API tokens
# 3. For HuggingFace: Get token from https://huggingface.co/settings/tokens
# 4. For Ngrok: Get token from https://dashboard.ngrok.com/get-started/your-authtoken
# 5. Make sure Ollama is running locally if using local models